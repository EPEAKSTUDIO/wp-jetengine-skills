# JetEngine MCP — local credentials
# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# WordPress site URL — no trailing slash, no path
WP_SITE_URL=https://yourWordpressAddressHere

# Base64-encoded "username:app_password" — generated during setup.
# Raw username and password are NOT stored here; only the derived token.
# To generate: echo -n "your-admin-username:xxxx xxxx xxxx xxxx xxxx xxxx" | base64
JETENGINE_BASIC_AUTH=
